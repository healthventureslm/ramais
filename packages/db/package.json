{
  "name": "@ramais/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup": "tsx src/scripts/setup.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "reset": "tsx src/scripts/reset.ts && tsx src/scripts/setup.ts && tsx src/scripts/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0"
  }
}

# ---- Banco ----
# Papel da aplicação: sem BYPASSRLS e não é dono das tabelas.
DATABASE_URL=postgres://ramais_app@localhost:5544/ramais
# Papel dono: só para migrações e seed.
DATABASE_URL_OWNER=postgres://ramais_owner@localhost:5544/ramais
# Superusuário: só para `pnpm db:setup` (cria papéis e banco).
DATABASE_URL_ADMIN=postgres://postgres@localhost:5544/postgres

# ---- API ----
PORTA=3000
JWT_SEGREDO=troque-este-segredo-em-producao-com-32+caracteres
WEB_ORIGEM=http://localhost:5173
# Endereço público do app web: o QR do chat do quarto aponta para <WEB_URL_PUBLICA>/q/<código>.
# Vazio = o primeiro endereço de WEB_ORIGEM. Em produção, HTTPS.
WEB_URL_PUBLICA=

# ---- Meta / WhatsApp ----
# Com META_DRY_RUN=true nada é enviado à Meta: as saídas ficam registradas e aparecem no simulador.
META_DRY_RUN=true
META_APP_SECRET=segredo-dev-do-app
META_VERIFY_TOKEN=verificacao-dev
META_TOKEN=
META_API_VERSAO=v23.0

# ---- IA ----
# Sem chave, o sistema usa o motor de palavras-chave e não traduz.
OPENROUTER_API_KEY=
# typesafe/jev-* vai pela Decisions API (confiança nativa); os demais, por chat com IA_CONFIANCA.
IA_MODELO_ROTEAMENTO=typesafe/jev-1.13
# Usado se o principal falhar (disjuntor). Vazio = vai direto para as regras.
IA_MODELO_ROTEAMENTO_ALTERNATIVO=google/gemini-3.1-flash-lite
IA_MODELO_TRADUCAO=google/gemini-3.1-flash-lite
# Reserva da tradução: usado na hora em que o principal falha (ex.: limite do provedor). Vazio = sem reserva.
IA_MODELO_TRADUCAO_ALTERNATIVO=
IA_MODELO_RESPOSTA=google/gemini-3.5-flash-lite
IA_MODELO_MULTIMODAL=google/gemini-3.1-flash-lite
# logprobs | autoconsistencia
IA_CONFIANCA=autoconsistencia
# Só provedores que não retêm nem treinam com os dados.
IA_SEM_RETENCAO=true

# ---- Armazenamento ----
# local | s3
ARMAZENAMENTO=local
ARMAZENAMENTO_DIR=./armazenamento-local
S3_BUCKET=
AWS_REGION=sa-east-1

# ---- Push (FCM HTTP v1) ----
# JSON da conta de serviço em base64. Vazio = notificações só registradas no log.
FCM_CONTA_SERVICO_B64=

# ---- Docker (docker-compose.yml) ----
# Senhas dos papéis do banco no contêiner. Os defaults do compose servem só para a máquina local.
DB_SENHA_ADMIN=
DB_SENHA_OWNER=
DB_SENHA_APP=
# Porta da web no host (http://localhost:8080) e do Postgres do compose (só 127.0.0.1).
WEB_PORTA=8080
BANCO_PORTA=5545

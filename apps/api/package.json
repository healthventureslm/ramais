{
  "name": "@ramais/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx scripts/verificar-fronteiras.ts && tsc -p tsconfig.build.json && vitest run",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/main.api.js & node --watch --enable-source-maps dist/main.worker.js",
    "start:api": "node --enable-source-maps dist/main.api.js",
    "start:worker": "node --enable-source-maps dist/main.worker.js",
    "fronteiras": "tsx scripts/verificar-fronteiras.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@ramais/ai": "workspace:*",
    "@ramais/contracts": "workspace:*",
    "@ramais/db": "workspace:*",
    "@ramais/domain": "workspace:*",
    "@ramais/vertical-hotel": "workspace:*",
    "@socket.io/postgres-adapter": "^0.5.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.0",
    "socket.io-client": "^4.8.4"
  }
}

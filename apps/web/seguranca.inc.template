# Cabeçalhos de segurança, incluídos pelo nginx.conf.template em cada nível que tem add_header
# próprio (add_header num location apaga os do server). O envsubst troca ${CSP_HEADER} na subida.

add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;

# HTTPS obrigatório por 1 ano. Navegador só respeita quando chega por HTTPS (o proxy na frente);
# em http://localhost é ignorado. Sem includeSubDomains/preload: comprometem o domínio inteiro.
add_header Strict-Transport-Security "max-age=31536000" always;

# Nenhuma página do Ramais abre dentro de iframe de outro site.
add_header X-Frame-Options "DENY" always;

# Microfone: gravação de áudio no chat do quarto e no painel. O resto, ninguém.
add_header Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=(), usb=()" always;

# CSP. Tudo vem da própria origem: as fontes são do @fontsource (empacotadas), a API e o
# WebSocket passam pelo nginx em /api e /tempo-real.
#   img/media blob: — foto e áudio viram blob URL depois de buscados pela API (com token).
#   img data:       — QR do quarto (canvas → data URL).
# `style-src 'unsafe-inline'`: React e o design system usam style={...}.
add_header ${CSP_HEADER} "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" always;
